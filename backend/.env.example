# Shadow Agent local development environment
# Copy this file to backend/.env and replace the placeholder values.

# Compatibility/dev-only shared API keys.
# In production, prefer console login + managed API keys created from the admin backend.
SHADOW_AGENT_ADMIN_API_KEY=replace-with-long-random-admin-key
SHADOW_AGENT_CLIENT_API_KEY=replace-with-long-random-client-key
# Required for console login. The JWT signing key must be explicit — it is no
# longer derived from the static API keys above.
SHADOW_AGENT_JWT_SECRET=replace-with-a-random-string-at-least-32-characters
SHADOW_AGENT_API_KEY_PEPPER=replace-with-a-separate-random-string-for-managed-api-keys
SHADOW_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SHADOW_AGENT_DATABASE_PATH=shadow_agent.db

# Multi-tenancy + OIDC SSO
# Console SPA base URL: the backend redirects the browser here after the OIDC
# token exchange ({CONSOLE_URL}/sso/callback#access_token=... and on errors).
SHADOW_AGENT_CONSOLE_URL=http://localhost:3000
# Public base URL of this backend as the identity provider sees it — forms the
# OIDC redirect_uri ({PUBLIC_BASE_URL}/api/v1/auth/sso/callback) registered
# with each organization's IdP.
SHADOW_AGENT_PUBLIC_BASE_URL=http://localhost:8000
# Per-organization SSO connections are configured at runtime via
# PUT /api/v1/orgs/{org_id}/sso or the console "组织管理" view.

# Console login hardening: lock an account temporarily after repeated failures.
SHADOW_AGENT_LOGIN_MAX_FAILURES=5
SHADOW_AGENT_LOGIN_LOCKOUT_SECONDS=900

# Real upstream LLM proxy configuration
SHADOW_AGENT_UPSTREAM_BASE_URL=https://your-llm-provider.example.com
SHADOW_AGENT_UPSTREAM_API_KEY=replace-with-upstream-provider-key
SHADOW_AGENT_UPSTREAM_MODEL=replace-with-upstream-model-name
SHADOW_AGENT_UPSTREAM_TIMEOUT_SECONDS=60

# Console bootstrap policy
# Production recommendation: set a one-time bootstrap token, then use it only for
# the very first admin registration through /api/v1/auth/register.
SHADOW_AGENT_CONSOLE_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
# Local demo only. When true and no bootstrap token is configured, the first
# console registration can proceed without the bootstrap header.
SHADOW_AGENT_ALLOW_OPEN_CONSOLE_BOOTSTRAP=false

# Registration policy (applies AFTER the first admin exists)
# Default is closed: once an admin account exists, self-service registration is
# rejected unless one of the two options below enables it.
#   - Set SHADOW_AGENT_ALLOW_OPEN_REGISTRATION=true for local/open demo use.
#   - Or set SHADOW_AGENT_CONSOLE_INVITE_TOKEN and share it out-of-band; new
#     users must send it as X-Shadow-Agent-Invite-Token.
SHADOW_AGENT_ALLOW_OPEN_REGISTRATION=false
SHADOW_AGENT_CONSOLE_INVITE_TOKEN=replace-with-a-long-random-invite-token

# Role policy
# The very first registered console account uses SHADOW_AGENT_FIRST_USER_ROLE,
# but only after passing the bootstrap gate above.
# All later registrations default to client unless you override them here.
SHADOW_AGENT_FIRST_USER_ROLE=admin
SHADOW_AGENT_CONSOLE_DEFAULT_ROLE=client

# Local demo fallback only. Keep this false in production.
SHADOW_AGENT_ALLOW_SIMULATED_RESPONSES=true

# Automatic log retention (GDPR data minimization). The gateway purges expired
# rows at startup and then every SHADOW_AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS.
# Defaults: intercept logs / alerts / replay runs 180 days, audit logs 365 days.
# Set any per-table value to 0 to keep that table forever.
SHADOW_AGENT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_INTERCEPT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_AUDIT_LOG_RETENTION_DAYS=365
SHADOW_AGENT_ALERT_RETENTION_DAYS=180
SHADOW_AGENT_REPLAY_RETENTION_DAYS=180
SHADOW_AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# Intercept alerting (optional). Webhook receiver notified on every blocked
# request (Slack/Feishu/DingTalk or your own service). JSON POST with up to 3
# delivery attempts; set the secret to enable the X-ShadowAgent-Signature
# HMAC-SHA256 header so receivers can verify authenticity.
SHADOW_AGENT_ALERT_WEBHOOK_URL=
SHADOW_AGENT_ALERT_WEBHOOK_SECRET=

# Persisted-prompt redaction. Every prompt / context excerpt written to
# intercept_logs and audit_logs is masked with:
#   secrets (default) — credential shapes (sk-…, AKIA…, ghp_…, JWT, private
#                       key, key=value, Bearer …)
#   full              — secrets + email / mainland-China mobile / ID numbers
#   off               — store as received; only for a deployment that reads its
#                       audit trail as forensic evidence. Makes every stored
#                       prompt a potential secret at rest.
# An unrecognized value falls back to secrets, never to off.
SHADOW_AGENT_LOG_REDACT=secrets

# Request body ceiling in bytes. Requests above it are refused with 413 before
# the detectors see them (Content-Length first, then by counting the bytes that
# actually arrive, so a chunked body with no declared length is still capped).
# 0 disables the guard — only when something in front of the gateway already
# limits body size.
SHADOW_AGENT_MAX_BODY_BYTES=2097152

# /docs, /redoc and /openapi.json are opt-in and off by default: the schema
# enumerates every route including the admin-only ones. Enable only on a trusted
# interface, e.g. while exploring the API locally.
SHADOW_AGENT_DOCS_ENABLED=false

# --- upstream resilience ------------------------------------------------------
# Retries are deliberately narrow: only failures that provably never reached the
# model are retried (connect-phase errors, and HTTP 429 where the provider
# refused before generating). Read timeouts and 5xx are NOT retried by default,
# because a chat completion is not idempotent — a retry there can bill the same
# tokens twice and re-run a tool call that already executed.
SHADOW_AGENT_UPSTREAM_RETRY_MAX=2
SHADOW_AGENT_UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.25
# Wall-clock ceiling for one logical upstream call, retries included. Without it
# a 60 s timeout with two retries would hold a caller for three minutes.
SHADOW_AGENT_UPSTREAM_RETRY_BUDGET_SECONDS=90
# DANGEROUS: also retry read timeouts and 5xx. Expect duplicate billing and
# possibly duplicate tool execution. Leave off unless the deployment accepts it.
SHADOW_AGENT_UPSTREAM_RETRY_UNSAFE=false
# Circuit breaker: consecutive upstream failures that trip it, then how long it
# stays open before a single half-open probe is allowed. 0 disables the breaker.
SHADOW_AGENT_UPSTREAM_CIRCUIT_THRESHOLD=5
SHADOW_AGENT_UPSTREAM_CIRCUIT_COOLDOWN_SECONDS=30
# Off by default: the upstream client must not silently inherit HTTP(S)_PROXY
# from the shell, since its traffic carries prompts and completions. Set to true
# only when the gateway's egress genuinely requires an environment proxy.
SHADOW_AGENT_UPSTREAM_TRUST_ENV=false
