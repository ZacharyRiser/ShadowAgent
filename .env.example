# Shadow Agent compose environment — copy to .env and fill in real secrets.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required secrets (startup fails without them) ---
# JWT signing key for console sessions (min 32 chars). Never reuse across environments.
SHADOW_AGENT_JWT_SECRET=replace-with-random-32-plus-characters
# Static gateway API keys (machine-to-machine auth for client/admin callers).
SHADOW_AGENT_ADMIN_API_KEY=replace-with-random-admin-key
SHADOW_AGENT_CLIENT_API_KEY=replace-with-random-client-key
# Pepper for hashing managed API keys at rest.
SHADOW_AGENT_API_KEY_PEPPER=replace-with-random-pepper

# --- Console bootstrap ---
# Long random token required by the FIRST console admin registration.
SHADOW_AGENT_CONSOLE_BOOTSTRAP_TOKEN=replace-with-long-random-bootstrap-token
SHADOW_AGENT_ALLOW_OPEN_CONSOLE_BOOTSTRAP=false

# --- Networking ---
# Host ports published by docker compose.
SHADOW_AGENT_BACKEND_PORT=8000
SHADOW_AGENT_FRONTEND_PORT=3000
# CORS origins allowed to call the backend API.
SHADOW_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL the browser uses to reach the backend (baked into the frontend at build).
SHADOW_AGENT_PUBLIC_API_BASE=http://localhost:8000

# --- Multi-tenancy + OIDC SSO ---
# Base URL of the console SPA. After the OIDC token exchange the backend
# redirects the browser to {CONSOLE_URL}/sso/callback#access_token=... and to
# the same fragment for SSO errors. Must be reachable from the user's browser.
SHADOW_AGENT_CONSOLE_URL=http://localhost:3000
# Public base URL of this backend as seen by the identity provider. It forms
# the OIDC redirect_uri ({PUBLIC_BASE_URL}/api/v1/auth/sso/callback) that each
# organization registers with its IdP. Leave empty for local development.
SHADOW_AGENT_PUBLIC_BASE_URL=http://localhost:8000
# Per-organization SSO connections (provider, client_id/secret, issuer) are
# configured at runtime via the console "组织管理" view or
# PUT /api/v1/orgs/{org_id}/sso — no static env config needed for IdPs.

# --- Upstream LLM provider ---
SHADOW_AGENT_UPSTREAM_BASE_URL=https://api.example.com
SHADOW_AGENT_UPSTREAM_API_KEY=replace-with-upstream-provider-key
SHADOW_AGENT_UPSTREAM_MODEL=replace-with-upstream-model-name
# Simulated responses are for local demos only — keep false in production.
SHADOW_AGENT_ALLOW_SIMULATED_RESPONSES=false

# --- Request-side semantic injection detection (regex + local ML model) ---
# off | monitor | enforce. The ML layer is a shipped in-process classifier
# (zero network access). monitor flags suspects in the audit log without
# blocking — recommended for gray-launch evaluation before enforce.
SHADOW_AGENT_SEMANTIC_MODE=enforce
# Optional threshold override (0.5-0.99). Empty = use the value baked into
# backend/app/semantic_model.json by the trainer (precision-first).
SHADOW_AGENT_SEMANTIC_THRESHOLD=

# --- Response-side DLP (secrets in model output) ---
# off | monitor | redact | block. redact masks detected secrets (AWS/GitHub/
# OpenAI keys, JWT, private keys, custom rules) and forwards the sanitized
# response; monitor logs without modifying.
SHADOW_AGENT_RESPONSE_DLP_MODE=redact

# --- Tool permission policy ---
# How to treat a tool that has NO configured policy and no built-in default.
#   deny  (default) — allowlist stays strict: only tools with an explicit
#                     policy row (or one of the built-ins) may run.
#   allow           — third-party agent tools the gateway has no opinion about
#                     are permitted; their arguments are still screened by the
#                     behaviour-risk engine (dangerous commands, sensitive
#                     files, internal targets, credential access, secret
#                     exfiltration).
# Set to "allow" when connecting real agents whose tool names you have not
# enumerated — with the default, every unrecognised tool is refused.
SHADOW_AGENT_UNKNOWN_TOOL_POLICY=deny

# --- High availability (optional, multi-instance only) ---
# Share the rate limiter and login lockout across replicas. Requires the redis
# package (requirements-redis.txt) and build arg INSTALL_REDIS=true when using
# docker compose. Leave empty for single-instance deployments.
SHADOW_AGENT_REDIS_URL=
SHADOW_AGENT_ENABLE_REDIS=false

# --- Automatic log retention (GDPR data minimization) ---
# Expired rows are purged at startup and then periodically. Defaults: intercept
# logs / alerts / replay runs 180 days, audit logs 365 days. Set a per-table
# value to 0 to keep that table forever.
SHADOW_AGENT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_INTERCEPT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_AUDIT_LOG_RETENTION_DAYS=365
SHADOW_AGENT_ALERT_RETENTION_DAYS=180
SHADOW_AGENT_REPLAY_RETENTION_DAYS=180
SHADOW_AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# --- Intercept alerting (optional) ---
# Webhook receiver notified on every blocked request (Slack/Feishu/DingTalk or
# your own receiver). POST payload is JSON; delivery retries 3x with backoff.
SHADOW_AGENT_ALERT_WEBHOOK_URL=
# When set, each delivery carries X-ShadowAgent-Signature: sha256=<hmac> over
# the body bytes so receivers can verify authenticity.
SHADOW_AGENT_ALERT_WEBHOOK_SECRET=
